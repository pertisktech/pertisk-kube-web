# Linux environment for building .rpm with fpm (GNU tar + rpmbuild).
FROM debian:bookworm-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      ruby \
      ruby-dev \
      build-essential \
      rpm \
      cpio \
      zip \
    && gem install --no-document fpm \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
